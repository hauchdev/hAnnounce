# Normalize line endings in the repository and working tree.
* text=auto

# Explicit text file handling
*.java text
*.kt text
*.kts text
*.properties text
*.yml text
*.yaml text
*.md text
*.toml text

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# POSIX scripts must keep LF
gradlew text eol=lf
*.sh text eol=lf

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.gif binary
